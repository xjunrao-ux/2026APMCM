  "p0001-b0001": {
    "input_hash": "6a088d69a618fa229c177441a679bdd58e64e9e5c5c56c240fb1e8931dd23ee6",
    "action": "translate",
    "text": "2026 年亚太地区大学生数学建模竞赛",
    "styles": [],
    "anchor_protocol": true
  },
  "p0001-b0002": {
    "input_hash": "8c0c20aadd4d5ba5d55429829b5ccee6646e95b93e56962763f501825f79f350",
    "action": "translate",
    "text": "C 题",
    "styles": [],
    "anchor_protocol": true
  },
  "p0001-b0007": {
    "input_hash": "7a743e0cb273e63e4a21a7016b65cd78a703e61db96b1a90d8ba7b490baae241",
    "action": "translate",
    "text": "图 1. 在沿岸海域觅食的非洲企鹅",
    "styles": [
      {
        "start": 0,
        "end": 4,
        "source_anchor": "s0",
        "bold": true
      }
    ],
    "anchor_protocol": true
  },
  "p0002-b0001": {
    "input_hash": "6d538870dbeba24c8636a94c187cc10be1371cd09bc49d8a4fbb2878cfd1a11a",
    "action": "translate",
    "text": "抬起头、靠近或发出叫声作为回应。此外，他们还开展了声音传播实验，量化叫声频谱随传输距离增加而衰减的程度。这些实验数据为表征非洲企鹅在海上声学通信的有效距离、其行为反应模式及其对物种保护的意义提供了依据。",
    "styles": [],
    "anchor_protocol": true
  },
  "p0002-b0004": {
    "input_hash": "5d83b7e6783eb49992221813014423a6346d6a4105845b7a6198a856abe62a96",
    "action": "translate",
    "text": "问题 1 海面叫声的声学特征与分类",
    "styles": [],
    "anchor_protocol": true
  },
  "p0002-b0017": {
    "input_hash": "a7c50f960645a6b00950de1328a1bc31a60ba1b39d86eb454c14567adfc09678",
    "action": "translate",
    "text": "假设企鹅识别叫声的能力取决于传播后的信号与原始叫声之间的相关性",
    "styles": [],
    "anchor_protocol": true
  },
  "p0003-b0001": {
    "input_hash": "b972f700c41e0a139c48d8f83cc430d63ce4ca33a0beb07ca715fefb5e371974",
    "action": "translate",
    "text": "是否达到给定阈值，不同阈值代表不同的识别可靠度水平。设计一套覆盖多种识别状态的分级阈值方案，包括潜在识别、识别以及更为严格的可靠识别所需的最低相似度。重点关注两项判据：潜在识别的最低相似度阈值与可靠识别的更严格阈值。估计三种叫声类型在两项判据下各自的有效通信距离，报告不确定度范围，并开展敏感性分析。比较三种叫声类型在长距离传播中的稳健性，判断哪一种更适合在海上进行相对远距离的信息传递。",
    "styles": [],
    "anchor_protocol": true
  },
  "p0003-b0002": {
    "input_hash": "4fe95c4a018c877be620457933e8c354932efbdda4f78e324fd9fb55b2488972",
    "action": "translate",
    "text": "问题 3 海上回放实验中行为反应的建模",
    "styles": [],
    "anchor_protocol": true
  },
